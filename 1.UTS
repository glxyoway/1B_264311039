1. TABEL users
   TABEL artikel
   TABEL artikel_penulis

2. TABEL USER
CREATE TABLE users (
user_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
name VARCHAR(100) NOT NULL,
email VARCHAR(150) NOT NULL UNIQUE
);

TABEL artikel
CREATE TABLE artikel (
    article_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    category_id INT UNSIGNED NOT NULL,
    title VARCHAR(255) NOT NULL,
    published_at DATETIME NULL,
    status ENUM('draft', 'published', 'archived') DEFAULT 'draft' NOT NULL
);

TABEL artikel_penulis
CREATE TABLE artikel_penulis (
    article_id INT UNSIGNED NOT NULL,
    user_id INT UNSIGNED NOT NULL,
    peran_penulis VARCHAR(50) NOT NULL,
    PRIMARY KEY (article_id, user_id),
    CONSTRAINT fk_artikel_penulis_artikel FOREIGN KEY (article_id) REFERENCES artikel(article_id) ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_artikel_penulis_users FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE ON UPDATE CASCADE
);
